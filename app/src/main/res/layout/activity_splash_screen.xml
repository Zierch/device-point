<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dp_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    tools:context=".ui.SplashScreenActivity"
    tools:ignore="Overdraw">

    <View
        android:layout_width="1dp"
        android:layout_height="90dp" />

    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="150dp">

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/dp_circle_glow" />

        <View
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="@drawable/dp_tile_blue" />

        <ImageView
            android:layout_width="50dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@string/device_point_logo"
            android:src="@drawable/dp_laptop" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/dp_text"
        android:textSize="30sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/poppins_semi_bold"
        android:gravity="center"
        android:text="@string/dp_onboarding_tagline"
        android:textColor="@color/dp_primary"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/dp_onboarding_desc"
        android:textColor="@color/dp_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="22dp"
            android:layout_height="7dp"
            android:background="@drawable/dp_pill_blue" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/dp_circle_indicator" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/dp_circle_indicator" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnMulai"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/dp_pill_blue"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="@string/dp_mulai"
        android:textColor="@color/dp_bg"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btnLewati"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/dp_lewati"
        android:textColor="@color/dp_muted"
        android:textSize="13sp" />

    <View
        android:layout_width="1dp"
        android:layout_height="50dp" />

</LinearLayout>
