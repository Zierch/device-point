<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dp_bg"
    android:orientation="vertical"
    tools:context=".ui.BerandaActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/dp_sapaan"
                        android:textColor="@color/dp_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvNama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/app_name"
                        android:textColor="@color/dp_text"
                        android:textSize="18sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnNotif"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/dp_card_12">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/dp_belum_tersedia"
                        android:src="@drawable/dp_bell" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/dp_pill_blue" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/dp_card_14"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/dp_cari_beranda"
                    android:src="@drawable/dp_search" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/dp_cari_beranda"
                    android:textColor="@color/dp_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:background="@drawable/dp_card_solid"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="16dp"
                        android:layout_height="2dp"
                        android:background="@color/dp_primary" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="3dp"
                        android:background="@color/dp_primary" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="3dp"
                        android:background="@color/dp_primary" />
                </LinearLayout>
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/dp_card_20"
                android:padding="16dp">

                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="-10dp"
                    android:background="@drawable/dp_circle_glow" />

                <ImageView
                    android:layout_width="82dp"
                    android:layout_height="52dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="22dp"
                    android:contentDescription="@string/dp_promo_judul"
                    android:src="@drawable/dp_laptop" />

                <TextView
                    android:id="@+id/btnPromo"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:background="@drawable/dp_pill_amber"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/dp_promo_badge"
                    android:textColor="@color/dp_amber"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="210dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/btnPromo"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/dp_promo_judul"
                    android:textColor="@color/dp_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvPromoSub"
                    android:layout_width="210dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/btnPromo"
                    android:layout_marginTop="32dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/dp_promo_sub"
                    android:textColor="@color/dp_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnCekPromo"
                    android:layout_width="88dp"
                    android:layout_height="26dp"
                    android:layout_below="@id/tvPromoSub"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/dp_pill_blue"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:gravity="center"
                    android:text="@string/dp_cek_promo"
                    android:textColor="@color/dp_bg"
                    android:textSize="11sp" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipSemua"
                    android:layout_width="74dp"
                    android:layout_height="34dp"
                    android:background="@drawable/dp_pill_blue"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:gravity="center"
                    android:text="@string/dp_semua"
                    android:textColor="@color/dp_bg"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipLaptop"
                    android:layout_width="78dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/dp_pill_surface"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="@string/dp_chip_laptop"
                    android:textColor="@color/dp_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipPc"
                    android:layout_width="74dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/dp_pill_surface"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="@string/dp_chip_pc"
                    android:textColor="@color/dp_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipAksesoris"
                    android:layout_width="92dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/dp_pill_surface"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="@string/dp_chip_aksesoris"
                    android:textColor="@color/dp_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/dp_produk_pilihan"
                    android:textColor="@color/dp_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnLihatSemua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:text="@string/dp_lihat_semua"
                    android:textColor="@color/dp_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerBeranda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNavView"
        layout="@layout/view_bottom_nav" />

</LinearLayout>
